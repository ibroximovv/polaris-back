// Prisma schema for the Turizm API.
// Migrations: `npx prisma migrate dev --name <name>` (run from apps/api, see prisma.config.ts).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  full_name          String
  /// E.164 format, e.g. +998901234567
  phone              String    @unique
  email              String?   @unique
  /// argon2 hash of the password (never the plain value).
  password           String
  role               UserRole  @default(USER)
  is_active          Boolean   @default(true)
  /// argon2 hash of the current refresh token; null when logged out.
  refresh_token_hash String?
  last_login_at      DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  lesson_progress LessonProgress[]
  test_attempts   TestAttempt[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Learning: course -> modules -> lessons (video + guide + materials) -> test
// ---------------------------------------------------------------------------

model Course {
  id           String   @id @default(uuid()) @db.Uuid
  title        String
  description  String?
  cover_url    String?
  /// Students only see published courses.
  is_published Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  modules CourseModule[]

  @@map("courses")
}

model CourseModule {
  id          String   @id @default(uuid()) @db.Uuid
  course_id   String   @db.Uuid
  title       String
  description String?
  /// Order inside the course (ascending).
  position    Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  course  Course   @relation(fields: [course_id], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([course_id, position])
  @@map("course_modules")
}

/// A topic (mavzu): one video, a written guide and downloadable materials.
model Lesson {
  id             String   @id @default(uuid()) @db.Uuid
  module_id      String   @db.Uuid
  title          String
  description    String?
  /// Written guide for the lesson (markdown).
  content        String?
  video_url      String?
  /// Video length in seconds. Watch progress is measured against it.
  video_duration Int?
  /// Order inside the module (ascending).
  position       Int      @default(0)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  module    CourseModule     @relation(fields: [module_id], references: [id], onDelete: Cascade)
  materials LessonMaterial[]
  test      LessonTest?
  progress  LessonProgress[]

  @@index([module_id, position])
  @@map("lessons")
}

model LessonMaterial {
  id         String   @id @default(uuid()) @db.Uuid
  lesson_id  String   @db.Uuid
  title      String
  url        String
  position   Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  lesson Lesson @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@index([lesson_id, position])
  @@map("lesson_materials")
}

/// The test taken after a lesson's video. One per lesson.
model LessonTest {
  id           String   @id @default(uuid()) @db.Uuid
  lesson_id    String   @unique @db.Uuid
  title        String?
  /// Minimum percent (0-100) needed to pass.
  pass_score   Int      @default(70)
  /// null = unlimited attempts.
  max_attempts Int?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  lesson    Lesson         @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  questions TestQuestion[]
  attempts  TestAttempt[]

  @@map("lesson_tests")
}

model TestQuestion {
  id         String   @id @default(uuid()) @db.Uuid
  test_id    String   @db.Uuid
  text       String
  points     Int      @default(1)
  position   Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  test    LessonTest   @relation(fields: [test_id], references: [id], onDelete: Cascade)
  options TestOption[]
  answers TestAnswer[]

  @@index([test_id, position])
  @@map("test_questions")
}

model TestOption {
  id          String   @id @default(uuid()) @db.Uuid
  question_id String   @db.Uuid
  text        String
  /// Never sent to students.
  is_correct  Boolean  @default(false)
  position    Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  question TestQuestion @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@index([question_id])
  @@map("test_options")
}

model TestAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  test_id    String   @db.Uuid
  user_id    String   @db.Uuid
  score      Int
  max_score  Int
  /// score / max_score, rounded percent (0-100).
  percent    Int
  passed     Boolean
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  test    LessonTest   @relation(fields: [test_id], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  answers TestAnswer[]

  @@index([test_id, user_id])
  @@index([user_id])
  @@map("test_attempts")
}

model TestAnswer {
  id                  String   @id @default(uuid()) @db.Uuid
  attempt_id          String   @db.Uuid
  question_id         String   @db.Uuid
  selected_option_ids String[] @db.Uuid
  is_correct          Boolean
  points              Int
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  attempt  TestAttempt  @relation(fields: [attempt_id], references: [id], onDelete: Cascade)
  question TestQuestion @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@index([attempt_id])
  @@map("test_answers")
}

/// Per-user state of one lesson: exactly which parts of the video were watched, test result, completion.
model LessonProgress {
  id                  String    @id @default(uuid()) @db.Uuid
  user_id             String    @db.Uuid
  lesson_id           String    @db.Uuid
  /// Merged watched intervals in seconds: [[start, end], ...].
  watched_segments    Json      @default("[]")
  /// Unique seconds of the video watched (sum of watched_segments).
  watched_seconds     Int       @default(0)
  /// All watch time including rewatching.
  total_watch_seconds Int       @default(0)
  /// Where the player stopped last time (resume point).
  last_position       Int       @default(0)
  last_watch_at       DateTime?
  video_completed_at  DateTime?
  best_test_percent   Int?
  test_passed_at      DateTime?
  completed_at        DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@unique([user_id, lesson_id])
  @@index([lesson_id])
  @@map("lesson_progress")
}
