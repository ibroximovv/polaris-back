// Prisma schema for the Turizm API.
// Migrations: `npx prisma migrate dev --name <name>` (run from apps/api, see prisma.config.ts).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  full_name          String
  /// E.164 format, e.g. +998901234567
  phone              String    @unique
  email              String?   @unique
  /// argon2 hash of the password (never the plain value).
  password           String
  role               UserRole  @default(USER)
  is_active          Boolean   @default(true)
  /// argon2 hash of the current refresh token; null when logged out.
  refresh_token_hash String?
  last_login_at      DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  lesson_progress LessonProgress[]
  module_progress ModuleProgress[]
  test_attempts   TestAttempt[]
  uploads         Upload[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Files: every file is uploaded once through /uploads, then attached by id
// ---------------------------------------------------------------------------

enum UploadStatus {
  /// Presigned upload issued, the file is not confirmed yet.
  PENDING
  READY
}

/// A file stored in MinIO. Attached to at most one owner (lesson video or material);
/// deleting the owner deletes the upload and its object.
model Upload {
  id          String       @id @default(uuid()) @db.Uuid
  /// Object key in the storage bucket.
  object_key  String       @unique
  /// Original file name (used for downloads).
  file_name   String
  mime_type   String
  /// Bytes; for PENDING the declared size, then the stored size.
  size        BigInt
  status      UploadStatus @default(READY)
  uploaded_by String?      @db.Uuid
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt

  user            User?           @relation(fields: [uploaded_by], references: [id], onDelete: SetNull)
  lesson_video    LessonVideo?
  lesson_material LessonMaterial?

  @@index([status, created_at])
  @@map("uploads")
}

// ---------------------------------------------------------------------------
// Learning: course -> modules (final test) -> lessons (one video + guide + materials, optional test)
// ---------------------------------------------------------------------------

model Course {
  id           String   @id @default(uuid()) @db.Uuid
  title        String
  description  String?
  cover_url    String?
  /// Students only see published courses.
  is_published Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  modules CourseModule[]

  @@map("courses")
}

model CourseModule {
  id          String   @id @default(uuid()) @db.Uuid
  course_id   String   @db.Uuid
  title       String
  description String?
  /// Order inside the course (ascending).
  position    Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  course   Course           @relation(fields: [course_id], references: [id], onDelete: Cascade)
  lessons  Lesson[]
  /// Final test of the module; opens after every lesson of the module is completed.
  test     LessonTest?
  progress ModuleProgress[]

  @@index([course_id, position])
  @@map("course_modules")
}

/// A topic (mavzu): at most one video, a written guide, ordered materials (files, images) and an optional test.
model Lesson {
  id          String   @id @default(uuid()) @db.Uuid
  module_id   String   @db.Uuid
  title       String
  description String?
  /// Written guide for the lesson (markdown).
  content     String?
  /// Order inside the module (ascending).
  position    Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  module    CourseModule     @relation(fields: [module_id], references: [id], onDelete: Cascade)
  video     LessonVideo?
  materials LessonMaterial[]
  test      LessonTest?
  progress  LessonProgress[]

  @@index([module_id, position])
  @@map("lessons")
}

/// The single video of a lesson: an uploaded file (`upload_id`) or an external link (`external_url`), exactly one.
model LessonVideo {
  id           String   @id @default(uuid()) @db.Uuid
  lesson_id    String   @unique @db.Uuid
  upload_id    String?  @unique @db.Uuid
  external_url String?
  title        String?
  /// Length in seconds. Watch progress is measured against it; null = not tracked/required.
  duration     Int?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  lesson Lesson  @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  upload Upload? @relation(fields: [upload_id], references: [id], onDelete: Restrict)

  @@map("lesson_videos")
}

enum MaterialType {
  IMAGE
  FILE
}

/// A guide file or image of a lesson, shown in `position` order: an uploaded file or an external link, exactly one.
model LessonMaterial {
  id           String       @id @default(uuid()) @db.Uuid
  lesson_id    String       @db.Uuid
  upload_id    String?      @unique @db.Uuid
  external_url String?
  type         MaterialType @default(FILE)
  title        String?
  position     Int          @default(0)
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt

  lesson Lesson  @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  upload Upload? @relation(fields: [upload_id], references: [id], onDelete: Restrict)

  @@index([lesson_id, position])
  @@map("lesson_materials")
}

/// A test of a lesson (taken after its video) or the final test of a module. Exactly one of
/// `lesson_id` / `module_id` is set; a lesson and a module have at most one test each.
model LessonTest {
  id           String   @id @default(uuid()) @db.Uuid
  lesson_id    String?  @unique @db.Uuid
  module_id    String?  @unique @db.Uuid
  title        String?
  /// Points the test is worth. Questions without explicit points share what is left evenly.
  total_points Int      @default(100)
  /// Minimum percent (0-100) needed to pass.
  pass_score   Int      @default(70)
  /// null = unlimited attempts.
  max_attempts Int?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  lesson    Lesson?        @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  module    CourseModule?  @relation(fields: [module_id], references: [id], onDelete: Cascade)
  questions TestQuestion[]
  attempts  TestAttempt[]

  @@map("lesson_tests")
}

model TestQuestion {
  id         String   @id @default(uuid()) @db.Uuid
  test_id    String   @db.Uuid
  text       String
  /// Explicit points; null = an even share of what the test total leaves after explicit points.
  points     Int?
  position   Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  test    LessonTest   @relation(fields: [test_id], references: [id], onDelete: Cascade)
  options TestOption[]
  answers TestAnswer[]

  @@index([test_id, position])
  @@map("test_questions")
}

model TestOption {
  id          String   @id @default(uuid()) @db.Uuid
  question_id String   @db.Uuid
  text        String
  /// Never sent to students.
  is_correct  Boolean  @default(false)
  position    Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  question TestQuestion @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@index([question_id])
  @@map("test_options")
}

model TestAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  test_id    String   @db.Uuid
  user_id    String   @db.Uuid
  score      Int
  max_score  Int
  /// score / max_score, rounded percent (0-100).
  percent    Int
  passed     Boolean
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  test    LessonTest   @relation(fields: [test_id], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  answers TestAnswer[]

  @@index([test_id, user_id])
  @@index([user_id])
  @@map("test_attempts")
}

model TestAnswer {
  id                  String   @id @default(uuid()) @db.Uuid
  attempt_id          String   @db.Uuid
  question_id         String   @db.Uuid
  selected_option_ids String[] @db.Uuid
  is_correct          Boolean
  points              Int
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  attempt  TestAttempt  @relation(fields: [attempt_id], references: [id], onDelete: Cascade)
  question TestQuestion @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@index([attempt_id])
  @@map("test_answers")
}

/// Per-user state of one lesson: exactly which parts of the video were watched, test result, completion.
model LessonProgress {
  id                  String    @id @default(uuid()) @db.Uuid
  user_id             String    @db.Uuid
  lesson_id           String    @db.Uuid
  /// Merged watched intervals in seconds: [[start, end], ...].
  watched_segments    Json      @default("[]")
  /// Unique seconds of the video watched (sum of watched_segments).
  watched_seconds     Int       @default(0)
  /// All watch time including rewatching.
  total_watch_seconds Int       @default(0)
  /// Where the player stopped last time (resume point).
  last_position       Int       @default(0)
  last_watch_at       DateTime?
  video_completed_at  DateTime?
  best_test_percent   Int?
  test_passed_at      DateTime?
  completed_at        DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@unique([user_id, lesson_id])
  @@index([lesson_id])
  @@map("lesson_progress")
}

/// Per-user state of a module's final test.
model ModuleProgress {
  id                String    @id @default(uuid()) @db.Uuid
  user_id           String    @db.Uuid
  module_id         String    @db.Uuid
  best_test_percent Int?
  test_passed_at    DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  user   User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  module CourseModule @relation(fields: [module_id], references: [id], onDelete: Cascade)

  @@unique([user_id, module_id])
  @@index([module_id])
  @@map("module_progress")
}
