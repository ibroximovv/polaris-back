// Prisma schema for the Turizm API.
// Migrations: `npx prisma migrate dev --name <name>` (run from apps/api, see prisma.config.ts).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  full_name          String
  /// E.164 format, e.g. +998901234567
  phone              String    @unique
  email              String?   @unique
  /// argon2 hash of the password (never the plain value).
  password           String
  role               UserRole  @default(USER)
  is_active          Boolean   @default(true)
  /// argon2 hash of the current refresh token; null when logged out.
  refresh_token_hash String?
  last_login_at      DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  @@map("users")
}
